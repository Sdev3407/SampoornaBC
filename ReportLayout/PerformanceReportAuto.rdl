                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=SUM(Fields!TOTAL_COST_OF_PRODUCTION2.Value)/SUM(Fields!Birds_Sold__kg_.Value)+SUM(Fields!TOTAL_AMOUNT_PAYABLE.Value)/SUM(Fields!Birds_Sold__kg_.Value)</Value>
