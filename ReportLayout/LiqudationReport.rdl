                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=((2 - Sum(Fields!BirdsSoldkg_GCStatement.Value) / SUM(Fields!BirdsSoldNos_GCStatement.Value)) / 4) + (SUM(Fields!FeedConsumptionkgs_GCStatement.Value) / SUM(Fields!BirdsSoldkg_GCStatement.Value))</Value>
